NODE_ENV=production
APP_URL=https://paavaraghi.ir/
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/data/paavaraghi.sqlite
# Enable only behind the shared Caddy proxy; do not publish the app port.
TRUST_PROXY=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret
# Enable after the merchant is approved and sandbox verification has passed.
CHECKOUT_ENABLED=false
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
# Use SMTP from your own mail service, or the optional Resend adapter.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

